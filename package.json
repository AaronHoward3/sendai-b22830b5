{
  "name": "irios",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names \"WEB,API,GEN\" --prefix-colors \"blue,green,magenta\" \"pnpm --filter ./apps/web dev\" \"pnpm --filter ./apps/api dev\" \"pnpm --filter ./apps/generator dev\"",
    "dev:web": "pnpm --filter ./apps/web dev",
    "dev:api": "pnpm --filter ./apps/api dev",
    "dev:generator": "pnpm --filter ./apps/generator dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter ./apps/web build",
    "build:api": "pnpm --filter ./apps/api build",
    "build:generator": "pnpm --filter ./apps/generator build",
    "check:unused": "knip && unimported && depcheck",
    "check:exports": "ts-prune",
    "check:cycles": "madge --extensions ts,tsx,js,jsx --circular .",
    "check:all": "pnpm run check:unused && pnpm run check:exports && pnpm run check:cycles",
    "preinstall": "npx -y only-allow pnpm"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "depcheck": "^1.4.7",
    "knip": "^5.63.0",
    "madge": "^8.0.0",
    "npm-run-all": "^4.1.5",
    "ts-prune": "^0.10.3",
    "unimported": "^1.31.0"
  },
  "overrides": {
    "rollup": "^4.24.0"
  }
}
