<mjml>
  <mj-head>
    <mj-attributes>
      <mj-text font-family="Helvetica Neue, Helvetica, Arial, sans-serif"></mj-text>
      <mj-button font-family="Helvetica Neue, Helvetica, Arial, sans-serif"></mj-button>
    </mj-attributes>
  </mj-head>
  <mj-body>
    
    <!-- Hero Block 1: heroBold1 - Background Image with Overlay Text -->
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section
      background-url="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png"
      background-size="cover"
      background-repeat="no-repeat"
      background-position="center center"
      padding="400px 20px"
      >
      <mj-column>
        <mj-text
        align="center"
        font-size="36px"
        padding-bottom="10px"
        >{{hero_title}}</mj-text>
        <mj-text
        align="center"
        font-size="18px"
        >{{hero_subtitle}}</mj-text>
      </mj-column>
    </mj-section>
    </mj-wrapper>

    <!-- Hero Block 2: heroBold2 - Text Above Image -->
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section padding="40px 20px 40px">
        <mj-column>
          <mj-divider border-width="2px" border-color="#ffffff" width="100px" padding-bottom="20px"></mj-divider>
          <mj-text align="center" font-size="38px" padding-bottom="10px">{{hero_title}}</mj-text>
          <mj-text align="center" font-size="18px" padding-bottom="20px">{{hero_subtitle}}</mj-text>
          <mj-divider border-width="2px" border-color="#ffffff" width="100px" padding-top="20px"></mj-divider>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          <mj-image src="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png" alt="{{hero_image_alt}}" padding="0px"></mj-image>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Hero Block 3: heroBold3 - Text Above Image (Simple) -->
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section padding="40px 20px">
        <mj-column>
          <mj-text align="center" font-size="34px" padding-bottom="10px">{{hero_title}}</mj-text>
          <mj-text align="center" font-size="16px">{{hero_subtitle}}</mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          <mj-image src="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png" alt="{{hero_image_alt}}" padding="0px"></mj-image>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Hero Block 4: heroBold4 - Image with Overlay Text -->
    <mj-wrapper padding="0px">
      <mj-section padding="0px">
        <mj-column>
          <mj-image
            src="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png"
            alt="{{hero_title}}"
            width="100%"
            padding="0"
            align="center">
          </mj-image>
        </mj-column>
      </mj-section>
      <mj-section 
        background-color="rgba(0,0,0,0.4)"
        padding-top="200px"
        padding-bottom="200px"
        padding-left="20px"
        padding-right="20px">
        <mj-column>
          <mj-text
            align="center"
            font-size="42px"
            padding="0px"
            color="#ffffff"
            font-weight="bold"
            text-shadow="2px 2px 4px rgba(0,0,0,0.8)">
            {{hero_title}}
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Hero Block 5: heroBoldStacked - Image Above Bold Text -->
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section padding="0px">
        <mj-column>
          <mj-image src="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png" alt="Hero" padding="0" border-radius="0px"></mj-image>
        </mj-column>
      </mj-section>
      <mj-section padding="60px 20px" background-color="#000000">
        <mj-column>
          <mj-text align="center" font-size="56px" font-weight="900" color="#ffffff" padding-bottom="20px" line-height="1.1" text-transform="uppercase" letter-spacing="2px">{{hero_title}}</mj-text>
          <mj-text align="center" font-size="24px" color="#ffffff" padding-bottom="40px" line-height="1.3">{{hero_subtitle}}</mj-text>
          <mj-button href="{{cta_url}}" background-color="#ffffff" color="#000000" border-radius="0px" padding="18px 40px" font-weight="900" text-transform="uppercase" letter-spacing="1px">
            {{cta_button_label}}
          </mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Hero Block 6: heroMinimal1 - Background Image with Minimal Text -->
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section
      background-url="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png"
      background-size="cover"
      background-repeat="no-repeat"
      background-position="center center"
      padding-top="300px"
      padding-bottom="300px"
      >
      <mj-column padding="100px">
        <mj-text align="center" font-size="40px" padding-bottom="10px">{{hero_title}}</mj-text>
        <mj-text align="center">{{hero_subtitle}}</mj-text>
      </mj-column>
    </mj-section>
    </mj-wrapper>

    <!-- Hero Block 7: heroMinimal2 - Image Above Text -->
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section padding="20px 20px">
        <mj-column>
          <mj-image src="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png" alt="{{hero_image_alt}}" height="800px" padding="0px"></mj-image>
          <mj-text align="center" font-size="30px" padding-top="40px" padding-bottom="10px">{{hero_title}}</mj-text>
          <mj-text align="center">{{hero_subtitle}}</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Hero Block 8: heroMinimal3 - Background Image with Centered Text -->
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section
      background-url="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png"
      background-size="cover"
      background-repeat="no-repeat"
      background-position="center center"
      padding="250px 20px"
      >
      <mj-column>
        <mj-text align="center" font-size="32px" padding-bottom="10px">{{hero_title}}</mj-text>
        <mj-text align="center" font-size="16px">{{hero_subtitle}}</mj-text>
      </mj-column>
    </mj-section>
    </mj-wrapper>

    <!-- Hero Block 9: heroMinimal4 - Background Image with Large Text -->
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section
      background-url="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png"
      background-size="cover"
      background-repeat="no-repeat"
      background-position="center center"
      padding="200px 20px"
      >
      <mj-column>
        <mj-text align="center" font-size="48px" padding-bottom="15px">{{hero_title}}</mj-text>
        <mj-text align="center" font-size="20px">{{hero_subtitle}}</mj-text>
      </mj-column>
    </mj-section>
    </mj-wrapper>

    <!-- Hero Block 10: heroMinimalCentered - Image Above Clean Text -->
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section padding="0px">
        <mj-column>
          <mj-image src="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png" alt="Hero" padding="0" border-radius="0px"></mj-image>
        </mj-column>
      </mj-section>
      <mj-section padding="80px 20px" background-color="#ffffff">
        <mj-column>
          <mj-text align="center" font-size="42px" font-weight="700" color="#000000" padding-bottom="15px" line-height="1.2">{{hero_title}}</mj-text>
          <mj-text align="center" font-size="18px" color="#666666" padding-bottom="30px" line-height="1.5">{{hero_subtitle}}</mj-text>
          <mj-button href="{{cta_url}}" background-color="#000000" color="#ffffff" border-radius="0px" padding="15px 30px" font-weight="600">
            {{cta_button_label}}
          </mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Hero Block 11: heroOverlayText - Background Image with Styled Overlay -->
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section background-url="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png" background-size="cover" background-repeat="no-repeat" background-position="center center" padding="200px 20px">
        <mj-column>
          <mj-text align="center" font-size="48px" font-weight="900" color="#ffffff" padding="20px" background-color="rgba(0,0,0,0.6)" border-radius="12px">{{hero_title}}</mj-text>
          <mj-text align="center" font-size="20px" color="#ffffff" padding="10px 20px" background-color="rgba(0,0,0,0.4)" border-radius="8px">{{hero_subtitle}}</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- Hero Block 12: heroSplitImage - Split Layout with Image and Text -->
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section padding="0px">
        <mj-column width="60%">
          <mj-image src="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png" alt="Hero" padding="0" border-radius="0px"></mj-image>
        </mj-column>
        <mj-column width="40%" vertical-align="middle" padding="40px 20px">
          <mj-text font-size="36px" font-weight="bold" padding-bottom="10px">{{hero_title}}</mj-text>
          <mj-text font-size="18px" padding-bottom="20px">{{hero_subtitle}}</mj-text>
          <mj-button href="{{cta_url}}" background-color="{{brand_color}}" color="#ffffff" border-radius="8px" padding="12px 24px">
            {{cta_button_label}}
          </mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>

  </mj-body>
</mjml>
