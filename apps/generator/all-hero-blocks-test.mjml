<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif"></mj-all>
      <mj-text font-size="16px" line-height="1.6"></mj-text>
      <mj-button font-weight="700" text-decoration="none"></mj-button>
      <mj-image border-radius="8px"></mj-image>
    </mj-attributes>
    <mj-style>
      .hero-section { background-color: #f8f9fa; }
      .headline { font-weight: 700; color: #1a1a1a; }
      .subhead { color: #666666; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#ffffff">
    
    <!-- ======================================== -->
    <!-- PROMOTION HERO BLOCKS -->
    <!-- ======================================== -->
    
    <!-- Hero Bold 1: Background Image with Overlay Text -->
    <mj-section background-color="#e5e7eb" padding="20px">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="700" color="#1a1a1a">
          PROMOTION HERO BLOCKS
        </mj-text>
      </mj-column>
    </mj-section>
    
    <!-- Hero Bold 1 -->
    <mj-section background-color="#f0f0f0" padding="10px">
      <mj-column>
        <mj-text align="center" font-size="18px" font-weight="600" color="#666666">
          Hero Bold 1: Background Image with Overlay Text
        </mj-text>
      </mj-column>
    </mj-section>
    
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section
      background-url="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png"
      background-size="cover"
      background-repeat="no-repeat"
      background-position="center center"
      padding="400px 20px"
      >
      <mj-column>
        <mj-text
        align="center"
        font-size="36px"
        padding-bottom="10px"
        color="#ffffff"
        font-weight="700"
        text-shadow="2px 2px 4px rgba(0,0,0,0.8)"
        >Kith Kids Fall 2025</mj-text>
        <mj-text
        align="center"
        font-size="18px"
        color="#ffffff"
        text-shadow="1px 1px 2px rgba(0,0,0,0.8)"
        >Discover the latest collection</mj-text>
      </mj-column>
    </mj-section>
    </mj-wrapper>
    
    <!-- Hero Bold 2 -->
    <mj-section background-color="#f0f0f0" padding="10px">
      <mj-column>
        <mj-text align="center" font-size="18px" font-weight="600" color="#666666">
          Hero Bold 2: Text First, Then Image
        </mj-text>
      </mj-column>
    </mj-section>
    
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section padding="40px 20px 40px">
        <mj-column>
          <mj-divider border-width="2px" border-color="#1a1a1a" width="100px" padding-bottom="20px"></mj-divider>
          <mj-text align="center" font-size="38px" padding-bottom="10px" font-weight="700">Kith Kids Fall 2025</mj-text>
          <mj-text align="center" font-size="18px" padding-bottom="20px">Discover the latest collection</mj-text>
          <mj-divider border-width="2px" border-color="#1a1a1a" width="100px" padding-top="20px"></mj-divider>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          <mj-image src="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png" alt="Kith Kids Fall 2025" padding="0px"></mj-image>
        </mj-column>
