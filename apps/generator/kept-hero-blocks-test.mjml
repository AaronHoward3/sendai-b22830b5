<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif"></mj-all>
      <mj-text font-size="16px" line-height="1.6"></mj-text>
      <mj-button font-weight="700" text-decoration="none"></mj-button>
      <mj-image border-radius="8px"></mj-image>
    </mj-attributes>
    <mj-style>
      .hero-section { background-color: #f8f9fa; }
      .headline { font-weight: 700; color: #1a1a1a; }
      .subhead { color: #666666; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#ffffff">
    
    <!-- ======================================== -->
    <!-- KEPT HERO BLOCKS -->
    <!-- ======================================== -->
    
    <mj-section background-color="#e5e7eb" padding="20px">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="700" color="#1a1a1a">
          KEPT HERO BLOCKS (9 Total)
        </mj-text>
      </mj-column>
    </mj-section>
    
    <!-- Hero Bold 1: Background Image with Overlay Text -->
    <mj-section background-color="#f0f0f0" padding="10px">
      <mj-column>
        <mj-text align="center" font-size="18px" font-weight="600" color="#666666">
          Hero Bold 1: Background Image with Overlay Text
        </mj-text>
      </mj-column>
    </mj-section>
    
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section
      background-url="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png"
      background-size="cover"
      background-repeat="no-repeat"
      background-position="center center"
      padding="400px 20px"
      >
      <mj-column>
        <mj-text
        align="center"
        font-size="36px"
        padding-bottom="10px"
        color="#ffffff"
        font-weight="700"
        text-shadow="2px 2px 4px rgba(0,0,0,0.8)"
        >Kith Kids Fall 2025</mj-text>
        <mj-text
        align="center"
        font-size="18px"
        color="#ffffff"
        text-shadow="1px 1px 2px rgba(0,0,0,0.8)"
        >Discover the latest collection</mj-text>
      </mj-column>
    </mj-section>
    </mj-wrapper>
    
    <!-- Hero Bold 2: Text First, Then Image -->
    <mj-section background-color="#f0f0f0" padding="10px">
      <mj-column>
        <mj-text align="center" font-size="18px" font-weight="600" color="#666666">
          Hero Bold 2: Text First, Then Image
        </mj-text>
      </mj-column>
    </mj-section>
    
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section padding="40px 20px 40px">
        <mj-column>
          <mj-divider border-width="2px" border-color="#1a1a1a" width="100px" padding-bottom="20px"></mj-divider>
          <mj-text align="center" font-size="38px" padding-bottom="10px" font-weight="700">Kith Kids Fall 2025</mj-text>
          <mj-text align="center" font-size="18px" padding-bottom="20px">Discover the latest collection</mj-text>
          <mj-divider border-width="2px" border-color="#1a1a1a" width="100px" padding-top="20px"></mj-divider>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          <mj-image src="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png" alt="Kith Kids Fall 2025" padding="0px"></mj-image>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    
    <!-- Hero Bold 3: Text Above Image -->
    <mj-section background-color="#f0f0f0" padding="10px">
      <mj-column>
        <mj-text align="center" font-size="18px" font-weight="600" color="#666666">
          Hero Bold 3: Text Above Image
        </mj-text>
      </mj-column>
    </mj-section>
    
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section padding="40px 20px">
        <mj-column>
          <mj-text align="center" font-size="34px" padding-bottom="10px" font-weight="700">Kith Kids Fall 2025</mj-text>
          <mj-text align="center" font-size="16px">Discover the latest collection</mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          <mj-image src="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png" alt="Kith Kids Fall 2025" padding="0px"></mj-image>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    
    <!-- Hero Bold Stacked: Stacked Layout -->
    <mj-section background-color="#f0f0f0" padding="10px">
      <mj-column>
        <mj-text align="center" font-size="18px" font-weight="600" color="#666666">
          Hero Bold Stacked: Stacked Layout
        </mj-text>
      </mj-column>
    </mj-section>
    
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section padding="0px">
        <mj-column>
          <mj-image src="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png" alt="Hero" padding="0" border-radius="0px"></mj-image>
        </mj-column>
      </mj-section>
      <mj-section padding="80px 20px" background-color="#ffffff">
        <mj-column>
          <mj-text align="center" font-size="56px" font-weight="900" color="#000000" padding-bottom="20px" line-height="1.1" text-transform="uppercase" letter-spacing="2px">KITH KIDS</mj-text>
          <mj-text align="center" font-size="24px" color="#000000" padding-bottom="40px" line-height="1.3">Fall 2025 Collection</mj-text>
          <mj-button href="https://kith.com/collections/kith-kids-fall-2025" background-color="#000000" color="#ffffff" border-radius="0px" padding="18px 40px" font-weight="900" text-transform="uppercase" letter-spacing="1px">
            Shop Now
          </mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    
    <!-- Hero Minimal 1: Background Image with Centered Text -->
    <mj-section background-color="#f0f0f0" padding="10px">
      <mj-column>
        <mj-text align="center" font-size="18px" font-weight="600" color="#666666">
          Hero Minimal 1: Background Image with Centered Text
        </mj-text>
      </mj-column>
    </mj-section>
    
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section
      background-url="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png"
      background-size="cover"
      background-repeat="no-repeat"
      background-position="center center"
      padding-top="300px"
      padding-bottom="300px"
      >
      <mj-column padding="100px">
        <mj-text align="center" font-size="40px" padding-bottom="10px" color="#ffffff" font-weight="700" text-shadow="2px 2px 4px rgba(0,0,0,0.8)">Kith Kids Fall 2025</mj-text>
        <mj-text align="center" color="#ffffff" text-shadow="1px 1px 2px rgba(0,0,0,0.8)">Discover the latest collection</mj-text>
      </mj-column>
    </mj-section>
    </mj-wrapper>
    
    <!-- Hero Minimal Centered: Image Above Centered Text -->
    <mj-section background-color="#f0f0f0" padding="10px">
      <mj-column>
        <mj-text align="center" font-size="18px" font-weight="600" color="#666666">
          Hero Minimal Centered: Image Above Centered Text
        </mj-text>
      </mj-column>
    </mj-section>
    
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section padding="0px">
        <mj-column>
          <mj-image src="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png" alt="Hero" padding="0" border-radius="0px"></mj-image>
        </mj-column>
      </mj-section>
      <mj-section padding="80px 20px" background-color="#ffffff">
        <mj-column>
          <mj-text align="center" font-size="42px" font-weight="700" color="#000000" padding-bottom="15px" line-height="1.2">Kith Kids Fall 2025</mj-text>
          <mj-text align="center" font-size="18px" color="#666666" padding-bottom="30px" line-height="1.5">Discover the latest collection</mj-text>
          <mj-button href="https://kith.com/collections/kith-kids-fall-2025" background-color="#000000" color="#ffffff" border-radius="0px" padding="15px 30px" font-weight="600">
            Shop Now
          </mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    
    <!-- Hero Overlay Text: Background Image with Overlay Boxes -->
    <mj-section background-color="#f0f0f0" padding="10px">
      <mj-column>
        <mj-text align="center" font-size="18px" font-weight="600" color="#666666">
          Hero Overlay Text: Background Image with Overlay Boxes
        </mj-text>
      </mj-column>
    </mj-section>
    
    <mj-wrapper padding="0px" css-class="hero-section">
      <mj-section background-url="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png" background-size="cover" background-repeat="no-repeat" background-position="center center" padding="200px 20px">
        <mj-column>
          <mj-text align="center" font-size="48px" font-weight="900" color="#ffffff" padding="20px" background-color="rgba(0,0,0,0.6)" border-radius="12px">Kith Kids Fall 2025</mj-text>
          <mj-text align="center" font-size="20px" color="#ffffff" padding="10px 20px" background-color="rgba(0,0,0,0.4)" border-radius="8px">Discover the latest collection</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    
    <!-- Hero Bold N4: Label + Headline -->
    <mj-section background-color="#f0f0f0" padding="10px">
      <mj-column>
        <mj-text align="center" font-size="18px" font-weight="600" color="#666666">
          Hero Bold N4: Label + Headline
        </mj-text>
      </mj-column>
    </mj-section>
    
    <mj-section padding="30px 20px 10px">
      <mj-column>
        <mj-text align="center" font-size="13px" padding-bottom="8px" color="#666666">NEW COLLECTION</mj-text>
        <mj-text align="center" font-size="30px" class="headline" font-weight="700">Kith Kids Fall 2025</mj-text>
        <mj-text align="center" font-size="16px" class="subhead">Discover the latest collection</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0px 20px 30px">
      <mj-column>
        <mj-image src="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png" alt="Bold Visual" border-radius="8px" padding="0px"></mj-image>
      </mj-column>
    </mj-section>
    
    <!-- Hero Minimal N1: Image Above Text -->
    <mj-section background-color="#f0f0f0" padding="10px">
      <mj-column>
        <mj-text align="center" font-size="18px" font-weight="600" color="#666666">
          Hero Minimal N1: Image Above Text
        </mj-text>
      </mj-column>
    </mj-section>
    
    <mj-section padding="0px">
      <mj-column>
        <mj-image mj-class="img" src="https://masxzswlivypqantomhc.supabase.co/storage/v1/object/public/hero_images/hero-images/5057d832-5f25-4f57-a082-2c89d6daa61c/kith.com/1756409002507.png" alt="Newsletter Hero" padding="0px"></mj-image>
      </mj-column>
    </mj-section>
    <mj-section padding="30px 20px 10px">
      <mj-column>
        <mj-text mj-class="h1" align="center" font-size="26px" class="headline" padding-bottom="10px" font-weight="700">Kith Kids Fall 2025</mj-text>
        <mj-text mj-class="h2" align="center" font-size="16px" class="subtext">Discover the latest collection</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="0 20px">
      <mj-column>
        <mj-divider padding="10px 0"></mj-divider>
      </mj-column>
    </mj-section>
    
    <!-- ======================================== -->
    <!-- END OF KEPT HERO BLOCKS -->
    <!-- ======================================== -->
    
    <mj-section background-color="#e5e7eb" padding="20px">
      <mj-column>
        <mj-text align="center" font-size="24px" font-weight="700" color="#1a1a1a">
          END OF KEPT HERO BLOCKS
        </mj-text>
        <mj-text align="center" font-size="16px" color="#666666" padding-top="10px">
          9 hero blocks kept, 12 removed
        </mj-text>
      </mj-column>
    </mj-section>
    
  </mj-body>
</mjml>
